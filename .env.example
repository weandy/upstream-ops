# ===== 1. 基础设施层（每次重启容器以 .env / 环境变量为准）=====

# 前端对外端口（容器内 backend 仍是 8418，nginx 已下线，前端直接由 Go 嵌入 serve）
HTTP_PORT=8080

# 拉取的镜像 tag
IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
SERVER_MODE=release
LOG_LEVEL=info

# 默认 SQLite 单文件。docker-compose.yml 已内置同样配置；这里主要给本地直跑或自定义覆盖用。
DATABASE_DRIVER=sqlite
DATABASE_PATH=/app/data/upstream-ops.db

# 叠加 docker-compose.mysql.yml 时使用这组 MySQL 参数
MYSQL_DATABASE=upstreamops
MYSQL_USER=upstreamops
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=33069

# 叠加 docker-compose.postgres.yml 时使用这组 PostgreSQL 参数
POSTGRES_DB=upstreamops
POSTGRES_USER=upstreamops
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=54329
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Shanghai

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 修改后既有数据无法解密，请务必妥善保存。
APP_SECRET=please-change-me-to-a-long-random-secret-32bytes-min

# ===== 2. 首次启动初始化种子（仅在 data/config.yaml 尚不存在时生效）=====
# data/config.yaml 生成后，鉴权、调度、通知、代理、网关、站点运维等动态业务配置
# 一律以 data/config.yaml 为唯一真相源：网页保存/应用立即生效，重启容器也不会被这里覆盖。
# 如忘记密码需解锁，直接编辑 data/config.yaml 将 auth.enabled 改为 false 后重启即可。
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=
