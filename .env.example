# ===== 1. 基础设施层（每次重启容器以 .env / 环境变量为准）=====

# 宿主机绑定 IP（默认 0.0.0.0 支持公网直接访问；如前面已挂载 Nginx/Caddy 反代，建议改为 127.0.0.1）
HTTP_BIND_IP=0.0.0.0
# 宿主机对外 HTTP 端口（默认 8418，与容器内 backend 端口一致；nginx 已下线，前端直接由 Go 嵌入 serve）
HTTP_PORT=8418

# 拉取的镜像 tag
IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
SERVER_MODE=release
LOG_LEVEL=info
# 受信反代 IP / CIDR（逗号分隔，例如 172.17.0.1 或 127.0.0.1）。留空表示直连模式，忽略一切 X-Forwarded-For / X-Real-IP 头
SERVER_TRUSTED_PROXIES=
# 生产强鉴权开关（true 时禁止关闭鉴权、禁止使用默认密码 admin_ops 或空/占位 APP_SECRET）
SERVER_REQUIRE_SECURE_AUTH=true

# 默认 SQLite 单文件。docker-compose.yml 已内置同样配置；这里主要给本地直跑或自定义覆盖用。
DATABASE_DRIVER=sqlite
DATABASE_PATH=/app/data/upstream-ops.db

# 叠加 docker-compose.mysql.yml 时使用这组 MySQL 参数（默认不对外暴露宿主机端口）
MYSQL_DATABASE=upstreamops
MYSQL_USER=upstreamops
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=33069

# 叠加 docker-compose.postgres.yml 时使用这组 PostgreSQL 参数（默认不对外暴露宿主机端口）
POSTGRES_DB=upstreamops
POSTGRES_USER=upstreamops
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Shanghai

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 使用一键脚本会自动生成；手工部署请运行 `openssl rand -hex 32` 填入。修改后既有数据无法解密。
APP_SECRET=

# ===== 2. 首次启动初始化种子（仅在 data/config.yaml 尚不存在时生效）=====
# data/config.yaml 生成后，鉴权、调度、通知、代理、网关、站点运维等动态业务配置
# 一律以 data/config.yaml 为唯一真相源：网页保存/应用立即生效，重启容器也不会被这里覆盖。
# 一键部署会自动生成随机强密码写入本文件；手工首次启动必须填写 6 位以上强密码（禁止使用默认弱密码）。
# 如忘记密码需解锁，直接编辑 data/config.yaml 修改 auth.password 后重启容器即可。
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_TOKEN_SECRET=
